# pnpm's symlinked layout: a package sees its own declared runtime dependencies and
# nothing else from its siblings. Shared tooling (typescript, vitest, eslint) lives in
# root devDependencies and resolves by directory walk-up, which is intended; runtime
# dependencies must be declared locally or the import fails.
node-linker=isolated
strict-peer-dependencies=true
auto-install-peers=false
resolution-mode=highest
engine-strict=true
