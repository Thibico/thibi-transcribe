{
  "name": "@thibi/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@thibi/core": "workspace:*",
    "@thibi/db": "workspace:*",
    "@thibi/languages": "workspace:*",
    "@thibi/storage": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.0",
    "is-zawgyi": "^1.0.3",
    "pg-boss": "12.27.0",
    "rabbit-node": "^1.0.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1106.0"
  }
}
