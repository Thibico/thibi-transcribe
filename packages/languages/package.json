{
  "name": "@thibi/languages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "gen": "tsx scripts/gen-languages.ts",
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@thibi/core": "workspace:*"
  },
  "devDependencies": {
    "cldr-core": "^48.2.0",
    "cldr-localenames-full": "^48.2.0",
    "zod": "^4.4.3"
  }
}
