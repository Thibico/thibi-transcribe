{
  "name": "@thibi/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@thibi/core": "workspace:*",
    "@thibi/engine": "workspace:*",
    "@thibi/languages": "workspace:*",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@types/tar-stream": "^3.1.4"
  }
}
