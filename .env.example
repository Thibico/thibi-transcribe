# thibi-transcribe — local development environment.
#
# Copy to `.env` and fill in. In a deployed instance almost none of this is used:
# provider keys live encrypted in Postgres and are set in the browser, because any flow
# that forces an admin back into a dotfile to add a key is a design failure. This file
# exists for the CLI and the Phase 0-8 engine work, which run before `/settings` exists.

# --- Google Speech-to-Text v2 (primary provider) ---------------------------------

# Path to a service-account JSON with roles/speech.client.
GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json

# Optional. Read from the service-account JSON's project_id when omitted.
GOOGLE_PROJECT_ID=

# Region is a free choice; pick the one nearest your users.
#
# The old app carried a doctrine that Chirp 2 + my-MM only worked in a narrow overlap of
# regions and that us-central1 failed. That is measured false, twice: the 2026-07-30
# provider probe accepted all 117 locale codes in asia-southeast1, europe-west4 AND
# us-central1, and spike S3 on 2026-08-09 got a 200 with identical correct Burmese output
# from all three. Do not reintroduce it. The only real regional constraint is that a
# batchRecognize staging bucket must be a single region matching the recognizer.
GOOGLE_REGION=asia-southeast1

GOOGLE_MODEL=chirp_2

# Optional. Unset means long files use chunked parallel sync, which spike S3 measured as
# faster than batchRecognize at every duration tested (3.6-7x). Set this only to opt into
# the cheaper, slower Dynamic Batch path. Must be a single-region bucket in GOOGLE_REGION
# with a delete-after-1-day lifecycle rule; the engine asserts the rule and refuses to
# stage without it.
GOOGLE_GCS_STAGING_BUCKET=

# --- Whisper providers (Phase 4) --------------------------------------------------

OPENAI_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------------------------------
# Datastores. These match infra/compose.dev.yml, so `docker compose -f infra/compose.dev.yml
# up -d` and these values are a working local setup with nothing else to configure.
#
# Absent from this file until 2026-08-10, which meant a fresh clone following it got
# "DATABASE_URL is not set" from the first command it ran.
# ---------------------------------------------------------------------------------------
DATABASE_URL=postgres://thibi:thibi@localhost:5433/thibi
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
# The endpoint the *sidecar container* reaches MinIO on, when that differs from the one
# above. SigV4 signs the Host header, so a URL this CLI presigns against localhost:9000 is
# rejected 403 the moment the sidecar fetches it as minio:9000 — which is exactly what the
# first real diarization did (spike S8). Needed only when running the CLI from the host
# against a containerised sidecar; leave it unset when the engine runs inside compose too.
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_BUCKET=thibi
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=thibi
S3_SECRET_ACCESS_KEY=thibi-dev-secret

# ---------------------------------------------------------------------------------------
# This instance's signing secret. Generate one per deployment:
#
#     openssl rand -base64 48
#
# URL import signs the estimate a user approves with it, so the cost cannot change between
# resolving a URL and downloading it. Phase 10 reuses it for provider credentials, and
# phase 15 documents losing it as unrecoverable — it is deliberately not in backups.
# ---------------------------------------------------------------------------------------
APP_SECRET_KEY=

# ---------------------------------------------------------------------------------------
# Ingest. URL import is on unless disabled; an empty host allowlist means any host.
# ---------------------------------------------------------------------------------------
INGEST_URL_ENABLED=true
INGEST_URL_ALLOWED_HOSTS=
YT_DLP_PATH=yt-dlp
INGEST_MAX_UPLOAD_BYTES=2147483648
