# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# build output
dist/
.turbo/

# testing
coverage/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
!.env.example

# service-account keys and credentials — anything in here can spend against
# your billing account. This repo is public; do not weaken these patterns.
/keys/
*service-account*.json
*-credentials.json
*.p12
gha-creds-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local notes — strategy, research and one-off docs. Reference material, not project source.
*.local.md
/research/

# raw spike responses — several MB of provider JSON. The measurements distilled from
# them are committed in spikes/RESULTS.md and plans/phase-00-spike-results.md; the
# bytes are kept locally so a disputed number can be re-checked.
/spikes/raw/

# python — S6 runs pyannote through `uv run`, which needs no venv in-tree, but the
# interpreter still writes bytecode next to the spike.
__pycache__/
*.py[cod]
.venv/
