# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# build output
dist/
.turbo/

# testing
coverage/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
!.env.example

# service-account keys and credentials — anything in here can spend against
# your billing account. This repo is public; do not weaken these patterns.
/keys/
*service-account*.json
*-credentials.json
*.p12
gha-creds-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local notes — strategy, research and one-off docs. Reference material, not project source.
*.local.md
/research/

# raw spike responses — several MB of provider JSON. The measurements distilled from
# them are committed in spikes/RESULTS.md and plans/phase-00-spike-results.md; the
# bytes are kept locally so a disputed number can be re-checked.
/spikes/raw/

# real-world test media and the transcripts made from it. Kept on disk so a measurement
# can be re-run against the same audio, and out of git because this repo is public: the
# recordings are third-party material and some are editorially sensitive. Anything here
# is local-only by design — do not `git add -f` it, and do not name its sources in any
# committed file. Measurements distilled from it belong in the plans; the bytes do not.
/testdata/

# python — S6 runs pyannote through `uv run`, which needs no venv in-tree, but the
# interpreter still writes bytecode next to the spike.
__pycache__/
*.py[cod]
.venv/

# Worktrees created for background agents. Each is a git repo of its own; committing
# one lands a submodule entry nobody can clone.
.claude/worktrees/
