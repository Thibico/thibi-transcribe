{
  "name": "@thibi/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@thibi/core": "workspace:*",
    "@thibi/db": "workspace:*",
    "@thibi/engine": "workspace:*",
    "@thibi/languages": "workspace:*",
    "@thibi/runtime": "workspace:*",
    "@thibi/storage": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "bin": {
    "thibi-worker": "./dist/main.js"
  }
}
