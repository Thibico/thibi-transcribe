{
  "name": "@thibi/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "thibi": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@thibi/core": "workspace:*",
    "@thibi/db": "workspace:*",
    "@thibi/engine": "workspace:*",
    "@thibi/eval": "workspace:*",
    "@thibi/languages": "workspace:*",
    "@thibi/storage": "workspace:*",
    "commander": "^14.0.2",
    "google-auth-library": "^11.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0"
  }
}
