{
  "name": "thibi-transcribe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "_engines_note": "Raised from >=22.11 on 2026-08-14: pg-boss 12 declares >=22.12.0, and .npmrc sets engine-strict=true, so the old floor was a claim this repo could not honour \u2014 an install on 22.11 fails, and it fails pointing at pg-boss rather than at us.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "pretest": "turbo run build",
    "test": "vitest run",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b",
    "gen": "turbo run gen",
    "thibi": "node apps/cli/dist/index.js",
    "test:contract": "RUN_CONTRACT=1 vitest run --project packages packages/engine/src/diarize/__tests__/pyannote.contract.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.12",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "google-auth-library": "^11.0.0",
    "tsx": "^4.20.6",
    "turbo": "^2.5.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
